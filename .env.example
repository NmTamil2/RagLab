# RAGLab — root environment template
#
# This file documents the variables the project uses. Copy it, do not edit it:
#   cp .env.example .env
# Real .env files are git-ignored and must never contain committed secrets.
#
# There are two more specific templates:
#   backend/.env.example   -> copy to backend/.env
#   frontend/.env.example  -> copy to frontend/.env
#
# Step 1 needs no secrets at all. API keys (for example the xAI Grok key)
# arrive in a later milestone and will be added to backend/.env.example then.

# --- Backend ---------------------------------------------------------------
APP_NAME=RAGLab API
APP_VERSION=0.1.0
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
