# Backend configuration template.
# Copy to backend/.env and adjust. Never commit backend/.env.
#
#   cd backend
#   cp .env.example .env
#
# Every variable here is read by app/core/config.py. Defaults in that file
# already match these values, so the backend runs even without a .env.

# Name shown in the API docs and in the health response.
APP_NAME=RAGLab API

# Version reported by /api/health.
APP_VERSION=0.4.0

# development | production — reported by /api/health.
ENVIRONMENT=development

# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed frontend URL here when you deploy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded PDFs are saved. Relative paths are resolved against backend/.
# This folder is git-ignored — uploaded files must never reach GitHub.
DOCUMENTS_DIR=storage/documents

# Largest upload accepted, in megabytes.
MAX_UPLOAD_SIZE_MB=20

# --- Chunking ---------------------------------------------------------------
# Both values are in CHARACTERS. These are the two knobs you tune when
# experimenting: change them here, restart the backend, chunk a document again
# and compare. No Python file needs editing.

# Characters per chunk.
CHUNK_SIZE=500

# Characters each chunk repeats from the end of the previous one.
# Must be smaller than CHUNK_SIZE — the server refuses to start otherwise.
CHUNK_OVERLAP=50
