# Frontend configuration template.
# Copy to frontend/.env and adjust. Never commit frontend/.env.
#
#   cd frontend
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to browser code by Vite.
# Because this value ships to the browser, NEVER put a secret here.
#
# Vite reads .env at server start — restart `npm run dev` after changing it.

# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000
